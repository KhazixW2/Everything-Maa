{
  "name": "everything-maa",
  "version": "0.2.0",
  "description": "Install MaaFramework lifecycle skills and versioned MCP profiles for Claude Code and Codex.",
  "type": "module",
  "bin": {
    "everything-maa": "packages/cli/bin/everything-maa.js"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.json",
    "adapters/",
    "docs/",
    "distribution/",
    "integrations/",
    "mcp/",
    "packages/cli/",
    "recipes/",
    "scripts/check-release.mjs",
    "scripts/smoke-maafw-cli.mjs",
    "scripts/smoke-create-maa-project.mjs",
    "skills/",
    "!skills/**/__pycache__/**",
    "!skills/**/*.py[cod]",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepublishOnly": "npm test && npm run release:check",
    "release:check": "node scripts/check-release.mjs",
    "smoke:maafw-cli": "node scripts/smoke-maafw-cli.mjs",
    "smoke:create-project": "node scripts/smoke-create-maa-project.mjs",
    "test": "node --test tests/node/cli.test.mjs",
    "test:node": "node --test tests/node/cli.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "maa",
    "maaframework",
    "cli",
    "claude-code",
    "codex",
    "mcp"
  ],
  "author": "KhazixW2",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhazixW2/Everything-Maa.git"
  },
  "homepage": "https://github.com/KhazixW2/Everything-Maa#readme"
}
